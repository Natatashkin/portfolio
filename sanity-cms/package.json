{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/language-filter": "^5.0.19",
    "@sanity/vision": "^6.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.18.0",
    "sanity-plugin-internationalized-array": "^5.3.2",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
