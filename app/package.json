{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "typegen": "pnpm --dir ../sanity-cms typegen",
    "circular-dependencies-check": "npx madge --extensions ts,tsx --ts-config tsconfig.json -c src",
    "code-quality": "pnpm lint && pnpm format:check && pnpm type-check && pnpm circular-dependencies-check",
    "prepare": "cd .. && husky app/.husky || true"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0",
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md}": "prettier --write"
  }
}
